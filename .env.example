MCP_DOMAIN=cycling.example.com
# 一键部署会填写以下 OAuth 配置；与 iGPSPORT 登录凭据独立。
MCP_PUBLIC_URL=
MCP_ADMIN_USERNAME=owner
MCP_ADMIN_PASSWORD_HASH=
MCP_OAUTH_STORAGE_KEY=
IGPSPORT_TOKEN=
IGPSPORT_USERNAME=
IGPSPORT_PASSWORD=
SYNC_INTERVAL_MINUTES=60
SYNC_PAGES=0
# 默认仅同步接口数据；需要逐点分析时设为 true。
SYNC_DOWNLOAD_FIT=false

# 本地运行及 Docker 挂载共用此宿主机路径；Windows 路径建议使用正斜杠。
IGPSPORT_WASM_PATH=assets/edge_core_wasm_bg-GHC38n8Q.wasm
