# TLS 由 Caddy 自动管理，所有 MCP 请求由后端验证 OAuth。
{$MCP_DOMAIN} {
    request_body {
        max_size 1MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        -Server
    }
    reverse_proxy cycling-server:8000 {
        flush_interval -1
    }
}
